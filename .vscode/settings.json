{
  "editor.formatOnSaveMode": "file",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always"
    }
  },
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.format.oxc": "always",
      "source.fixAll.oxc": "always"
    }
  },
  "[json][jsonc][css][html][markdown][yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": true,
  "oxc.requireConfig": false,
  "oxc.configPath": "apps/web/vite.config.ts",
  "oxc.fmt.configPath": "apps/web/vite.config.ts",
  "oxc.path.oxlint": ".vscode/oxlint.mjs",
  "oxc.path.oxfmt": ".vscode/oxfmt.mjs",
  "oxc.fixKind": "safe_fix",
  "oxc.typeAware": true,
  "ruff.importStrategy": "fromEnvironment",
  "python.languageServer": "None",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "ty.disableLanguageServices": false,
  "ty.diagnosticMode": "workspace",
  "ty.importStrategy": "useBundled",
  "ty.interpreter": "${workspaceFolder}/.venv",
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true,
    "**/src/client/**": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "**/src/client/**": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true,
    "**/src/client/**": true
  },
  "python.testing.pytestArgs": ["apps"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
